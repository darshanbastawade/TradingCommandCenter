{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ConnectionStrings": { "TradingDatabase": "" },
  "AzureOpenAI": {
    "Endpoint": "",
    "Deployment": "",
    "TimeoutSeconds": 120,
    "MaximumInputCharacters": 750000,
    "MaximumOutputTokens": 4000,
    "ReasoningEffort": "low"
  },
  "Zerodha": {
    "LiveWebSocketEndpoint": "wss://ws.kite.trade",
    "SandboxWebSocketEndpoint": "wss://ws-sandbox.kite.trade",
    "AllowLiveFeed": false,
    "AllowLiveOrders": false,
    "ReceiveBufferBytes": 65536
  },
  "LiveTrading": {
    "KillSwitchEngaged": true,
    "AllowDirectOrders": false,
    "MaximumBrokerDataAgeSeconds": 5,
    "MaximumLimitPremiumBasisPoints": 25,
    "MinimumPaperSessions": 10,
    "MinimumPaperFilledTrades": 30,
    "RequirePositivePaperNetPnl": true
  },
  "StrategyRanking": {
    "Qualification": {
      "MinimumTrades": 30,
      "MinimumAverageNetR": 0.10,
      "MinimumProfitFactor": 1.20,
      "MaximumDrawdownPercent": 0.20,
      "MinimumWalkForwardProfitableFoldRate": 0.60,
      "MinimumParameterStabilityScore": 70,
      "MinimumProfitableRegimeRate": 0.50,
      "MaximumSelections": 2
    },
    "Weights": {
      "AverageNetR": 20,
      "ProfitFactor": 15,
      "Drawdown": 15,
      "WalkForward": 20,
      "ParameterRobustness": 15,
      "RegimeBreadth": 10,
      "SampleSize": 5
    },
    "Scales": {
      "FullCreditAverageNetR": 0.50,
      "FullCreditProfitFactor": 2.0,
      "FullCreditTradeCount": 60
    }
  },
  "RiskPolicy": {
    "PolicyId": "india-intraday-options-conservative-v1",
    "Capital": {
      "TotalCapital": 300000,
      "ProtectedReserve": 150000,
      "ActiveTradingCapital": 100000,
      "StrategyTestingCapital": 30000,
      "CashBuffer": 20000
    },
    "MaximumRiskPerTrade": 750,
    "MaximumDailyLoss": 1500,
    "MaximumWeeklyLoss": 3000,
    "MaximumMonthlyLoss": 6000,
    "MaximumAggregateOpenRisk": 750,
    "MaximumTradesPerDay": 3,
    "MaximumConsecutiveLossesPerDay": 2,
    "MaximumOpenPositions": 1,
    "EntryWindowStart": "09:15:00",
    "LastEntryTime": "15:00:00",
    "MandatoryExitTime": "15:25:00",
    "RequireQualifiedStrategy": true
  },
  "StrategyCertificates": {
    "PolicyVersion": "strategy-certificate-v1",
    "ValidityDays": 90,
    "MaximumCertificatesPerRun": 2
  }
}
