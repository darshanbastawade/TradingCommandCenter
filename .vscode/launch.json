{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trading Command Center",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Trading.Api/bin/Debug/net10.0/Trading.Api.dll",
      "cwd": "${workspaceFolder}/src/Trading.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5080" },
      "serverReadyAction": { "action": "openExternally", "pattern": "\\bNow listening on:\\s+(https?://\\S+)" }
    }
  ]
}
